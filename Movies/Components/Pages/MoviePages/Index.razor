@page "/movies"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Movies.Models
@implements IAsyncDisposable
@inject IDbContextFactory<MoviesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="movies/create">Create New</a>
    <br />
    <label>Колличетсво записей : @totalItems</label>
    <br />
    <label>Записей на странице :</label>
    <input type="number" min="1" max="@int.MaxValue " @bind-value="itemsPerPage" @bind-value:after="UpdateItemsPerPageFromPagination" />
</p>

<QuickGrid Class="table" ItemsProvider="GetMovies" TGridItem="Movie" Pagination="pagination">
    @* <PropertyColumn Property="movie => movie.Title" /> *@
    <TemplateColumn Context="movie" Title="Название фильма">
        <a href="@($"movies/details?id={movie.Id}")">@movie.Title</a>
    </TemplateColumn>
    <PropertyColumn Property="movie => movie.ReleaseDate" Title="Дата выхода" />
    <PropertyColumn Property="movie => movie.Genre" Title="Жанр" />

    @*<TemplateColumn Context="movie">
        <a href="@($"movies/details?id={movie.Id}")">Details</a>
    </TemplateColumn> *@
</QuickGrid>
<Paginator State="pagination" />

@code {
    private MoviesContext context = default!;

    int totalItems = 0;
    int itemsPerPage = 3;

    PaginationState pagination = new PaginationState { ItemsPerPage = 3 };

    void UpdateItemsPerPageFromPagination()
    {
        pagination.ItemsPerPage = itemsPerPage = itemsPerPage > totalItems ? totalItems : itemsPerPage;
    }
    async ValueTask<GridItemsProviderResult<Movie>> GetMovies(GridItemsProviderRequest<Movie> request)
    {
        MoviesContext context = DbFactory.CreateDbContext();
        totalItems = await context.Movie.CountAsync(request.CancellationToken);

        IQueryable<Movie> query = context.Movie.OrderBy(x => x.Id);
        query = request.ApplySorting(query).Skip(request.StartIndex).Take(pagination.ItemsPerPage);

        ICollection<Movie> items = await query.ToArrayAsync(request.CancellationToken);
        context.Dispose();
        return new GridItemsProviderResult<Movie>
        {
            Items = items,
            TotalItemCount = totalItems
        };
    }
    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
