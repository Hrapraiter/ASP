@page "/requireddisciplines/edit"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>RequiredDiscipline</h2>
<hr />
@if (RequiredDiscipline is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="RequiredDiscipline" OnValidSubmit="UpdateRequiredDiscipline" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                @* <input type="hidden" name="RequiredDiscipline.discipline" value="@RequiredDiscipline.discipline" /> *@
                <div class="mb-3">
                    <label for="discipline" class="form-label">discipline:</label>
                    <InputNumber id="discipline" @bind-Value="RequiredDiscipline.discipline" class="form-control" />
                    <ValidationMessage For="() => RequiredDiscipline.discipline" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="required_discipline" class="form-label">required_discipline:</label>
                    <InputNumber id="required_discipline" @bind-Value="RequiredDiscipline.required_discipline" class="form-control" />
                    <ValidationMessage For="() => RequiredDiscipline.required_discipline" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/requireddisciplines">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int discipline { get; set; }

    [SupplyParameterFromForm]
    private RequiredDiscipline? RequiredDiscipline { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        RequiredDiscipline ??= await context.RequiredDisciplines.FirstOrDefaultAsync(m => m.discipline == discipline);

        if (RequiredDiscipline is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateRequiredDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(RequiredDiscipline!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!RequiredDisciplineExists(RequiredDiscipline!.discipline))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/requireddisciplines");
    }

    private bool RequiredDisciplineExists(int discipline)
    {
        using var context = DbFactory.CreateDbContext();
        return context.RequiredDisciplines.Any(e => e.discipline == discipline);
    }
}
