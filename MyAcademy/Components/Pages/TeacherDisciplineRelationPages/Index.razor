@page "/teacherdisciplinerelations"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="teacherdisciplinerelations/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.TeachersDisciplinesRelation">
    <PropertyColumn Property="teacherdisciplinerelation => teacherdisciplinerelation.teacher" />
    <PropertyColumn Property="teacherdisciplinerelation => teacherdisciplinerelation.discipline" />

    <TemplateColumn Context="teacherdisciplinerelation">
        <a href="@($"teacherdisciplinerelations/edit?teacher={teacherdisciplinerelation.teacher}&discipline={teacherdisciplinerelation.discipline}")">Edit</a> |
        <a href="@($"teacherdisciplinerelations/details?teacher={teacherdisciplinerelation.teacher}&discipline={teacherdisciplinerelation.discipline}")">Details</a> |
        <a href="@($"teacherdisciplinerelations/delete?teacher={teacherdisciplinerelation.teacher}&discipline={teacherdisciplinerelation.discipline}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private PV_522_ImportContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
