@page "/dependentdisciplines"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="dependentdisciplines/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.DependentDisciplines">
    <PropertyColumn Property="dependentdiscipline => dependentdiscipline.discipline" />
    <PropertyColumn Property="dependentdiscipline => dependentdiscipline.dependent_discipline" />

    <TemplateColumn Context="dependentdiscipline">
        <a href="@($"dependentdisciplines/edit?discipline={dependentdiscipline.discipline}&dependent_discipline={dependentdiscipline.dependent_discipline}")">Edit</a> |
        <a href="@($"dependentdisciplines/details?discipline={dependentdiscipline.discipline}&dependent_discipline={dependentdiscipline.dependent_discipline}")">Details</a> |
        <a href="@($"dependentdisciplines/delete?discipline={dependentdiscipline.discipline}&dependent_discipline={dependentdiscipline.dependent_discipline}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private PV_522_ImportContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
