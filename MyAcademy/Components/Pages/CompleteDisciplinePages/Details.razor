@page "/completedisciplines/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>CompleteDiscipline</h2>
    <hr />
    @if (completediscipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">discipline</dt>
            <dd class="col-sm-10">@completediscipline.discipline</dd>
        </dl>
        <div>
            <a href="@($"/completedisciplines/edit?group={completediscipline.group}")">Edit</a> |
            <a href="@($"/completedisciplines")">Back to List</a>
        </div>
    }
</div>

@code {
    private CompleteDiscipline? completediscipline;

    [SupplyParameterFromQuery]
    private int group { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        completediscipline = await context.CompleteDisciplines.FirstOrDefaultAsync(m => m.group == group);

        if (completediscipline is null)
        {
            NavigationManager.NotFound();
        }
    }
}
