@page "/grades/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Grade</h2>
    <hr />
    @if (grade is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">lesson</dt>
            <dd class="col-sm-10">@grade.lesson</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">grade_1</dt>
            <dd class="col-sm-10">@grade.grade_1</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">grade_2</dt>
            <dd class="col-sm-10">@grade.grade_2</dd>
        </dl>
        <EditForm method="post" Model="grade" OnValidSubmit="DeleteGrade" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(grade is null)">Delete</button> |
            <a href="/grades">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Grade? grade;

    [SupplyParameterFromQuery]
    private int student { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        grade = await context.Grades.FirstOrDefaultAsync(m => m.student == student);

        if (grade is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteGrade()
    {
        using var context = DbFactory.CreateDbContext();
        context.Grades.Remove(grade!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/grades");
    }
}
