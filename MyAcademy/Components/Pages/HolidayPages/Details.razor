@page "/holidays/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Holiday</h2>
    <hr />
    @if (holiday is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">holiday_name</dt>
            <dd class="col-sm-10">@holiday.holiday_name</dd>
            <dt class="col-sm-2">mounth</dt>
            <dd class="col-sm-10">@holiday.mounth</dd>
            <dt class="col-sm-2">day</dt>
            <dd class="col-sm-10">@holiday.day</dd>
            <dt class="col-sm-2">duration</dt>
            <dd class="col-sm-10">@holiday.duration</dd>
        </dl>
        <div>
            <a href="@($"/holidays/edit?holiday_id={holiday.holiday_id}")">Edit</a> |
            <a href="@($"/holidays")">Back to List</a>
        </div>
    }
</div>

@code {
    private Holiday? holiday;

    [SupplyParameterFromQuery]
    private byte holiday_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        holiday = await context.Holidays.FirstOrDefaultAsync(m => m.holiday_id == holiday_id);

        if (holiday is null)
        {
            NavigationManager.NotFound();
        }
    }
}
