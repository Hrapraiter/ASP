@page "/holidays/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Holiday</h2>
    <hr />
    @if (holiday is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">holiday_name</dt>
            <dd class="col-sm-10">@holiday.holiday_name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">mounth</dt>
            <dd class="col-sm-10">@holiday.mounth</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">day</dt>
            <dd class="col-sm-10">@holiday.day</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">duration</dt>
            <dd class="col-sm-10">@holiday.duration</dd>
        </dl>
        <EditForm method="post" Model="holiday" OnValidSubmit="DeleteHoliday" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(holiday is null)">Delete</button> |
            <a href="/holidays">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Holiday? holiday;

    [SupplyParameterFromQuery]
    private byte holiday_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        holiday = await context.Holidays.FirstOrDefaultAsync(m => m.holiday_id == holiday_id);

        if (holiday is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteHoliday()
    {
        using var context = DbFactory.CreateDbContext();
        context.Holidays.Remove(holiday!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/holidays");
    }
}
