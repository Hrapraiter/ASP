@page "/disciplinedirectionrelations/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>DisciplineDirectionRelation</h2>
    <hr />
    @if (disciplinedirectionrelation is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">discipline</dt>
            <dd class="col-sm-10">@disciplinedirectionrelation.discipline</dd>
        </dl>
        <EditForm method="post" Model="disciplinedirectionrelation" OnValidSubmit="DeleteDisciplineDirectionRelation" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(disciplinedirectionrelation is null)">Delete</button> |
            <a href="/disciplinedirectionrelations">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private DisciplineDirectionRelation? disciplinedirectionrelation;

    [SupplyParameterFromQuery]
    private byte direction { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        disciplinedirectionrelation = await context.DisciplinesDirectionsRelation.FirstOrDefaultAsync(m => m.direction == direction);

        if (disciplinedirectionrelation is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteDisciplineDirectionRelation()
    {
        using var context = DbFactory.CreateDbContext();
        context.DisciplinesDirectionsRelation.Remove(disciplinedirectionrelation!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/disciplinedirectionrelations");
    }
}
