@page "/dayoffs"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="dayoffs/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.DaysOFF">
    <PropertyColumn Property="dayoff => dayoff.date" />
    <PropertyColumn Property="dayoff => dayoff.holiday" />

    <TemplateColumn Context="dayoff">
        <a href="@($"dayoffs/edit?date={dayoff.date}&date={dayoff.date}")">Edit</a> |
        <a href="@($"dayoffs/details?date={dayoff.date}&date={dayoff.date}")">Details</a> |
        <a href="@($"dayoffs/delete?date={dayoff.date}&date={dayoff.date}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private PV_522_ImportContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
