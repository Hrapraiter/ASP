@page "/dayoffs/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>DayOFF</h2>
    <hr />
    @if (dayoff is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">holiday</dt>
            <dd class="col-sm-10">@dayoff.holiday</dd>
        </dl>
        <div>
            <a href="@($"/dayoffs/edit?date={dayoff.date}")">Edit</a> |
            <a href="@($"/dayoffs")">Back to List</a>
        </div>
    }
</div>

@code {
    private DayOFF? dayoff;

    [SupplyParameterFromQuery]
    private System.DateOnly date { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        dayoff = await context.DaysOFF.FirstOrDefaultAsync(m => m.date == date);

        if (dayoff is null)
        {
            NavigationManager.NotFound();
        }
    }
}
