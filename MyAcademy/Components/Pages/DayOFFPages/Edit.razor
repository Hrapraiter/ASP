@page "/dayoffs/edit"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>DayOFF</h2>
<hr />
@if (DayOFF is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="DayOFF" OnValidSubmit="UpdateDayOFF" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="DayOFF.date" value="@DayOFF.date" />
                <div class="mb-3">
                    <label for="holiday" class="form-label">holiday:</label>
                    <InputNumber id="holiday" @bind-Value="DayOFF.holiday" class="form-control" />
                    <ValidationMessage For="() => DayOFF.holiday" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/dayoffs">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private System.DateOnly date { get; set; }

    [SupplyParameterFromForm]
    private DayOFF? DayOFF { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        DayOFF ??= await context.DaysOFF.FirstOrDefaultAsync(m => m.date == date);

        if (DayOFF is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateDayOFF()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(DayOFF!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!DayOFFExists(DayOFF!.date))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/dayoffs");
    }

    private bool DayOFFExists(System.DateOnly date)
    {
        using var context = DbFactory.CreateDbContext();
        return context.DaysOFF.Any(e => e.date == date);
    }
}
