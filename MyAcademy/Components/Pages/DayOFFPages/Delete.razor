@page "/dayoffs/delete"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<PV_522_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>DayOFF</h2>
    <hr />
    @if (dayoff is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">holiday</dt>
            <dd class="col-sm-10">@dayoff.holiday</dd>
        </dl>
        <EditForm method="post" Model="dayoff" OnValidSubmit="DeleteDayOFF" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(dayoff is null)">Delete</button> |
            <a href="/dayoffs">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private DayOFF? dayoff;

    [SupplyParameterFromQuery]
    private System.DateOnly date { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        dayoff = await context.DaysOFF.FirstOrDefaultAsync(m => m.date == date);

        if (dayoff is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteDayOFF()
    {
        using var context = DbFactory.CreateDbContext();
        context.DaysOFF.Remove(dayoff!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/dayoffs");
    }
}
