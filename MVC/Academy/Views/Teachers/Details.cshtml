@model Academy.Models.Teacher

@{
    ViewData["Title"] = "Details";
}


<div>
    <h2>@Model.FullName details</h2>
    <hr />
</div>
<div>
    <dl class="row">
        @* <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.last_name)</dt>  <dd class = "col-sm-10">@Html.DisplayFor(model => model.last_name)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.first_name)</dt> <dd class = "col-sm-10">@Html.DisplayFor(model => model.first_name)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.middle_name)</dt><dd class = "col-sm-10">@Html.DisplayFor(model => model.middle_name)</dd> *@
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.FullName)</dt>   <dd class = "col-sm-10">@Html.DisplayFor(model => model.FullName)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.birth_date)</dt> <dd class = "col-sm-10">@Html.DisplayFor(model => model.birth_date)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.email)</dt>      <dd class = "col-sm-10">@Html.DisplayFor(model => model.email)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.phone)</dt>      <dd class = "col-sm-10">@Html.DisplayFor(model => model.phone)</dd>
        @* <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.photo)</dt>      <dd class = "col-sm-10">@Html.DisplayFor(model => model.photo)</dd> *@
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.work_since)</dt> <dd class = "col-sm-10">@Html.DisplayFor(model => model.work_since)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.rate)</dt>       <dd class = "col-sm-10">@Html.DisplayFor(model => model.rate)</dd>
        <dt class = "col-sm-2">@Html.DisplayNameFor(model => model.TDRs)</dt>       
               <dd class = "col-sm-10">
                   <ul>
                       @foreach(TeachersDisciplinesRelation tdr in Model.TDRs)
                       {
                           <li>
                               @Html.DisplayFor(model => tdr.Discipline.discipline_name);
                           </li>
                       }
                   </ul>
               </dd>
    </dl>
</div>
<div class="submit-button-container">
    <a asp-action="Edit" asp-route-teacher_id="@Model?.teacher_id" class="btn btn-primary">Edit</a>
    <a asp-action="Delete" asp-route-teacher_id="@Model?.teacher_id" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-dark">Back to List</a>
</div>
