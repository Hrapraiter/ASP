@* @model IEnumerable<Academy.Models.Teacher> *@
@model PaginatedList<Academy.Models.Teacher>

@{
    ViewData["Title"] = "Teachers";

    string nameOrder = (string)ViewData["orderByName"];
    nameOrder = nameOrder == "" ? "asc" : nameOrder == "asc" ? "desc" : "";

    string dateOrder = (string)ViewData["orderByDate"];
    dateOrder = dateOrder == "" ? "asc" : dateOrder == "asc" ? "desc" : "";

    int[] selectedItems = new int[]{ 3 , 5 , 8 };

    string previusDisabled = Model.HasPreviusPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
    // string nameOrder = ViewData["orderByName"] == "" ? "asc" : ViewData["orderByName"] == "asc" ? "desc" : "";
    // string dateOrder = ViewData["orderByDate"] == "" ? "asc" : ViewData["orderByDate"] == "asc" ? "desc" : "";
}


<h2>Teachers</h2>
<form id="teachers-index-form-method-get" asp-action="Index" method="get">
    <div class="controls">
        <div class="search-container">
            <input type="search" name="searchString" value="@ViewData["searchString"]" class="form-control" />
            <input type="submit" value="Найти" class="btn btn-primary"/>
            <a asp-action="Index" class="btn btn-dark">Сброс</a>
        </div>
        <div id="teachers-index-select-items-per-page-container">
            <label for="teachers-index-select-items-per-page">Items Per Page : </label>
            <select id="teachers-index-select-items-per-page" name="pageSize" onchange="this.form.submit()">
                @foreach (int pageSize in selectedItems)
                {
                <option value="@pageSize" selected="@(pageSize == (int)ViewData["pageSize"])">@pageSize</option>
                }
            </select>
        </div>
        <a asp-action="Create" class="btn btn-primary">Добавить</a>
        <input hidden="hidden" name="orderByName" value="@ViewData["orderByName"]" />
        <input hidden="hidden" name="orderByDate" value="@ViewData["orderByDate"]" />
        <input hidden="hidden" name="pageIndex" value="0" />
    </div>
    @* <script>
        const container = document.getElementById("teachers-index-select-items-per-page-container");
        const form = document.getElementById("teachers-index-form-method-get");
        const select = document.getElementById("teachers-index-select-items-per-page");
        select.addEventListener('change', function () {
            container.innerHTML += '<input hidden="hidden" name="pageIndex" value="0"/>';
            container.innerHTML += '<input hidden="hidden" name="pageSize" value="' + select.value + '"/>';
            form.submit();
        });
    </script> *@
</form>

