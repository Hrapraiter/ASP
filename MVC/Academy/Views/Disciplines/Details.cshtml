@model Academy.Models.Discipline

@{
    ViewData["Title"] = "Details";
}
<h1>Details</h1>

<div>
    <h4>Discipline</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.discipline_name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.discipline_name)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.number_of_lessons)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.number_of_lessons)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TDRs)
        </dt>
        <dd class = "col-sm-10">
            <ul>
                @foreach(TeachersDisciplinesRelation TDR in Model.TDRs)
                {
                     <li>
                         @Html.DisplayFor(model => TDR.Teacher.FullName);
                     </li>
                }
            </ul>
        </dd>
    </dl>
</div>
<div class="submit-button-container">
    <a asp-action="Edit" asp-route-id="@Model?.discipline_id" class="btn btn-primary">Edit</a> 
    <a asp-action="Delete" asp-route-id="@Model?.discipline_id" class="btn btn-danger">Delete</a> 
    <a asp-action="Index" class="btn btn-dark">Back to List</a>
</div>
