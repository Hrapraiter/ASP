@model Academy.Models.Direction

@{
    ViewData["Title"] = "Details";
}

<div>
    <h2>@Model.direction_name details</h2>
    <hr />
</div>
<div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.direction_name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.direction_name)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.direction_id" class="btn btn-primary">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model?.direction_id" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-dark">Back to List</a>
</div>
