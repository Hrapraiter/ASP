@* @model IEnumerable<ContosoUniversity.Models.Course> *@
@model PaginatedList<Course>

@{
    ViewData["Title"] = "Index";
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage     ? "" : "disabled";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.First().Title)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Credits)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Enrollments)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Credits)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Enrollments)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-courseid="@item.CourseID">Edit</a> |
                        <a asp-action="Details" asp-route-courseid="@item.CourseID">Details</a> |
                        <a asp-action="Delete" asp-route-courseid="@item.CourseID">Delete</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
<div class="pagination-controls">
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex - 1)"
       class="btn btn-default @prevDisabled"
    >
    Prev
    </a>
    <div class="pagination-items">
        @for(int i = 0; i < Model.TotalPages;i++)
        {
            <a asp-action="Index"
               asp-route-pageIndex="@i"b
            >
               <div class="@(i == Model.PageIndex ? "selected-page" : "pagination-item")">
                    @(i + 1)
               </div>
            </a>
        }
    </div>
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex + 1)"
       class="btn btn-default @nextDisabled"
    >
    Next
    </a>
</div>