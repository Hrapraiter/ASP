@* @model IEnumerable<ContosoUniversity.Models.Student> *@
@model PaginatedList<Student>

@{
    ViewData["Title"] = "Students";
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<h1>Students</h1>
<form asp-action="Index" method="get">
    <label class="controls">
        Поиск по имени:
        <input type="search" name="SearchString" value="@ViewData["CurrentFilter"]"/>
        <input type="submit" value="Поиск" class="btn btn-primary"/>
        <a asp-action="Index" asp-route-pageIndex="0" class="btn btn-dark">Сброс</a>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
        <label for="items-per-page">Items per page:</label>
        <select name="itemsPerPage" onchange="this.form.submit()">
            <option value="3" selected="@(Convert.ToInt32(ViewData["ItemsPerPage"]) == 3)">3</option>
            <option value="5" selected="@(Convert.ToInt32(ViewData["ItemsPerPage"]) == 5)">5</option>
            <option value="8" selected="@(Convert.ToInt32(ViewData["ItemsPerPage"]) == 8)">8</option>
        </select>
    </label>

    
</form>
<div>
    @* <form method="get">
        <select name="itemsPerPage" onchange="this.form.submit()">
            @foreach (int pageSize in ViewBag.ItemsPerPages)
                {
                    <option value="@pageSize" selected="@(pageSize == Model.ItemsPerPage)">@pageSize</option>
                }
        </select>
        <input type="hidden" name="page" value="1"/>
    </form> *@

</div>
<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index"
                    asp-route-sortOrder="@ViewData["NameSortParam"]"
                    asp-route-searchString="@ViewData["CurrentFilter"]"
                    asp-route-itemsPerPage="@ViewData["ItemsPerPage"]"
                    >
                        @* Lastname *@
                        @Html.DisplayNameFor(model => model.First().LastName)
                        @* @Html.DisplayNameFor(model => model.LastName) *@
                    </a>
                </th>
                @* <th>
                    @Html.DisplayNameFor(model => model.First().FirstName)
                </th> *@
                <th>
                    <a asp-action="Index"
                    asp-route-sortOrder="@ViewData["DateSortParam"]"
                    asp-route-searchString="@ViewData["CurrentFilter"]"
                    asp-route-itemsPerPage="@ViewData["ItemsPerPage"]"
                    >
                        @* EnrollmentDate *@
                        @Html.DisplayNameFor(model => model.First().EnrollmentDate)
                        @* @Html.DisplayNameFor(model => model.EnrollmentDate) *@
                    </a>
                    @* @Html.DisplayNameFor(model => model.EnrollmentDate) *@
                </th>
                <th>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.FullName)
                </td>
                @* <td>
                    @Html.DisplayFor(model => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.FirstName)
                </td> *@
                <td>
                    @Html.DisplayFor(model => item.EnrollmentDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Enrollments)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>



<div class="pagination-controls">
     <a asp-action="Index"
     asp-route-pageIndex="@(Model.PageIndex - 1)"
     asp-route-searchString="@ViewData["CurrentFilter"]"
     asp-route-itemsPerPage="@ViewData["ItemsPerPage"]"
     class="btn btn-default @prevDisabled"
     >
         Prev
     </a>
     <div class="pagination-items">
         @for (int i = 0; i < Model.TotalPages; i++)
             {
                 <a asp-action="Index"
                 asp-route-pageIndex="@i"
                 asp-route-searchString="@ViewData["CurrentFilter"]"
                 asp-route-itemsPerPage="@ViewData["ItemsPerPage"]">
                     <div class="@(i == Model.PageIndex ? "selected-page" :"pagination-item")">   
                         @(i + 1)
                     </div>
                 </a>
             }
     </div>

    

    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex + 1)"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       asp-route-itemsPerPage="@ViewData["ItemsPerPage"]"
       class="btn btn-default @nextDisabled"
    >
        Next
    </a>
</div>