@* @model IEnumerable<ContosoUniversity.Models.Enrollment> *@
@model PaginatedList<Enrollment>

@{
    ViewData["Title"] = "Enrollments";
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled"; 
    string nextDisabled = Model.HasNextPage     ? "" : "disabled"; 
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="table-container">
    <table class="table">
        <thead>
             <tr>
                <th>
                    @Html.DisplayNameFor(model => model.First().CourseID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().StudentID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Grade)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Student)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.First().Course)
                </th>
                <th></th>
            </tr> 
        </thead>
        <tbody>
            @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.CourseID)
                </td>
                <td>
                    @Html.DisplayFor(model => item.StudentID)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Grade)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Student)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Course)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EnrollmentID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.EnrollmentID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.EnrollmentID">Delete</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

<div class="pagination-controls">
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex - 1)"
       class="btn btn-default @prevDisabled">
        Prev
    </a>
    <div class="pagination-items">
        @for(int i = 0; i < Model.TotalPages; i++)
        {
            <a asp-action="Index"
               asp-route-pageIndex="@i"
            >
                <div class="@(i == Model.PageIndex ? "selected-page" : "pagination-item")">
                    @(i+1)
                </div>
            </a>
        }
    </div>
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex + 1)"
       class="btn btn-default @nextDisabled">
        Next
    </a>
</div>
