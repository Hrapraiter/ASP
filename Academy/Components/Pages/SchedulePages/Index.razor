@page "/schedules"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Schedule Home ( Index )</PageTitle>


<div class="controls">
    <h1>Schedule</h1>
    <a href="schedules/create" class="btn btn-primary">Добавить</a>
</div>

<QuickGrid Class="table" Items="context.Schedule.Include(s => s.Group).Include(s => s.Teacher).Include(s => s.Discipline)">
    <TemplateColumn Context="schedule"
                    Title="lesson_id"
                    >
        <a href=@($"schedules/details?lesson_id={schedule.lesson_id}")>@schedule.lesson_id</a>
    </TemplateColumn>
    <PropertyColumn Property="schedule => schedule.Group.group_name" />
    <PropertyColumn Property="schedule => schedule.Teacher.FullName" Title="FullName"/>
    <PropertyColumn Property="schedule => schedule.Discipline.discipline_name" />
    <PropertyColumn Property="schedule => schedule.date" />
    <PropertyColumn Property="schedule => schedule.time" />
    <PropertyColumn Property="schedule => schedule.spent == null ? false : schedule.spent" Title="spent" />
    

    @* <TemplateColumn Context="schedule">
        <a href="@($"schedules/edit?lesson_id={schedule.lesson_id}")">Edit</a> |
        <a href="@($"schedules/details?lesson_id={schedule.lesson_id}")">Details</a> |
        <a href="@($"schedules/delete?lesson_id={schedule.lesson_id}")">Delete</a>
    </TemplateColumn> *@
</QuickGrid>

@code {
    private AcademyContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
