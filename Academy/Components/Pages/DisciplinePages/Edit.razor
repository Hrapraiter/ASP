@page "/disciplines/edit"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@rendermode InteractiveServer
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

@if (Discipline is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h2>@Discipline.discipline_name edit</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Discipline" OnValidSubmit="UpdateDiscipline" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Discipline.discipline_id" value="@Discipline.discipline_id" />
                <div class="mb-3">
                    <label for="discipline_name" class="form-label">discipline_name:</label>
                    <InputText id="discipline_name" @bind-Value="Discipline.discipline_name" class="form-control" />
                    <ValidationMessage For="() => Discipline.discipline_name" class="text-danger" />
                </div>
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="number_of_lessons" class="form-label">number_of_lessons:</label>
                    <InputNumber id="number_of_lessons" @bind-Value="Discipline.number_of_lessons" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Discipline.number_of_lessons" class="text-danger" />
                </div>
                @using (AcademyContext context = DbFactory.CreateDbContext()) 
                { 
                    <label class="form-label">Преподаватели:</label>
                    <ul>
                        @foreach (Teacher teacher in context.Teachers)
                        {
                            
                        <li style="display:flex">
                                @*<input type="checkbox" @onchange="e => isTeachers[teacher.teacher_id] = (bool)e.Value!" class="darker-border-checkbox">"*@
                                <input type="checkbox" @bind="isTeachers[teacher.teacher_id]" class="darker-border-checkbox">
                            <label class="form-check-label">@teacher.FullName</label>
                            <br />
                        </li>
                            
                        }
                    </ul>
                    
                }
                @* <div class="mb-3">
                    <label for="tdr" class="form-label">TDR:</label>
                    <InputText id="tdr" @bind-Value="Discipline.TDR" class="form-control" />
                    <ValidationMessage For="() => Discipline.TDR" class="text-danger" />
                </div> *@
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/disciplines">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    [SupplyParameterFromForm]
    private Discipline? Discipline { get; set; }

    IQueryable<Teacher> teachers { get; set; }
    public Dictionary<int, bool> isTeachers { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        teachers = context.Teachers.Include(t => t.TDR).ThenInclude(tdr => tdr.Discipline);
        Discipline ??= await context.Disciplines.Include(d => d.TDR).ThenInclude(tdr => tdr.Teacher).FirstOrDefaultAsync(m => m.discipline_id == discipline_id);
        HashSet<int> selectedTeachers = Discipline.TDR.Select(tdr => tdr.teacher).ToHashSet();
        isTeachers = teachers.ToDictionary(t => t.teacher_id, t => selectedTeachers.Contains(t.teacher_id));

        if (Discipline is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        // Console.WriteLine($"\x1b[32m{Discipline.TDR}\x1b[0m");

        HashSet<int> currentIds = Discipline.TDR.Select(tdr => tdr.teacher).ToHashSet(); // собирает id до изменений
        HashSet<int> selectedIds = isTeachers.Where(kvp => kvp.Value).Select(kvp => kvp.Key).ToHashSet(); // собирает локально изменёные id

        context.TeachersDisciplinesRelation.RemoveRange // опасно выносит записи ManyToMany 
                                                        // в данном случае по выборке TDR из Discipline объекта
                                                        // в данном случае выносит всё что не выбранно в UI
        (
            Discipline.TDR.Where(tdr => !selectedIds.Contains(tdr.teacher))
                          .ToArray()
        );
        context.TeachersDisciplinesRelation.AddRange // добавление новых записей и отфильтровываем те что не изменились
        (
            selectedIds.Where(id => !currentIds.Contains(id))
                       .Select(id => new TeachersDisciplinesRelation
                       {
                            teacher=id,
                            discipline=Discipline.discipline_id
                       })
                       .ToArray()
        );
        context.Attach(Discipline!).State = EntityState.Modified;
        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!DisciplineExists(Discipline!.discipline_id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }
        NavigationManager.NavigateTo($"/disciplines/details?discipline_id={Discipline.discipline_id}");
    }
    
    private bool DisciplineExists(int discipline_id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Disciplines.Any(e => e.discipline_id == discipline_id);
    }
}
