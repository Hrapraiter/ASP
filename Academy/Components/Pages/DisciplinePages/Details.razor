@page "/disciplines/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@rendermode InteractiveServer
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div>
    @if (discipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <p>
            <h2>@discipline.discipline_name</h2>
            <hr />
        </p>
        <dl class="row">
            <dt class="col-sm-4">discipline_name</dt>      <dd class="col-sm-10">@discipline.discipline_name</dd>
            <dt class="col-sm-4">number_of_lessons</dt>    <dd class="col-sm-10">@discipline.number_of_lessons</dd>
        </dl>
        <div>
            <a href="@($"/disciplines/edit?discipline_id={discipline.discipline_id}")" class="btn btn-primary">Edit</a>
            <a href=@($"/disciplines/delete?discipline_id={discipline.discipline_id}") class="btn btn-danger">Delete</a>
            <a href="@($"/disciplines")" class="btn btn-dark">Back to List</a>
        </div>
        <div class="controls">
            <h3>Преподаватели</h3>
            <h5>teacher_count: @discipline.TDR.Count()</h5>
        </div>
        <hr />
        <ul>
            @foreach (TeachersDisciplinesRelation tdr in discipline.TDR)
            {
                <li>@tdr.Teacher.FullName</li>
            }
        </ul>
    }
</div>

@code {
    private Discipline? discipline;

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Disciplines.Include(d => d.TDR).ThenInclude(tdr => tdr.Teacher).FirstOrDefaultAsync(m => m.discipline_id == discipline_id);

        if (discipline is null)
        {
            NavigationManager.NotFound();
        }
    }
}
