<h3>LearningDays</h3>

<ul class="learning-days">
    @for(int i = 0;i < 7;i++)
    {
        <li>
            <label for="@Week.DAYNAMES[i]">@Week.DAYNAMES[i]</label>
            <input type="checkbox" id="@Week.DAYNAMES[i]" @bind="@days[i]" />
        </li>
    }
</ul>

@code 
{
    bool[] days = new bool[7];

    [Parameter]
    public Models.Group Group { get; set; }

    void Update()
    {
        int output = 0;
        for (int i = 0; i < 7; i++)
        {
            output |= (days[i] ? 1 : 0) << i;
        }
        Group.learning_days = output;
    }
    void Extract()
    {
        for(int i = 0; i < 7;i++)
        {
            if(((Group.learning_days >> i) & 1) != 0)
            {
                days[i] = true;
            }
        }    
    }
    protected override void OnInitialized()
    {
        Extract();
    }
}
