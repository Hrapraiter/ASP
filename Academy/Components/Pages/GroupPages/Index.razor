@page "/groups"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<div class="controls">
    <p>
        <a href="groups/create">Create New</a>
    </p>
    <form action="/groups">
        <label for="groups-search">Поиск : </label>
        <input id="groups-search" type="search" name="TitleFilter" />
        <input type="submit" value="Найти" />
    </form>
    <div>
        <select @bind="pagination.ItemsPerPage">
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="10">10</option>
        </select>
    </div>
</div>

<QuickGrid Class="table" Items="FilteredGroups" Pagination="pagination">
    <PropertyColumn Property="group => group.group_name" />
    <PropertyColumn Property="group => group.direction" />
    <PropertyColumn Property="group => group.start_date" />
    <PropertyColumn Property="group => group.start_time" />
    <PropertyColumn Property="group => group.learning_days" />
    <PropertyColumn Property="group => group.Direction" />

    <TemplateColumn Context="group">
        <a href="@($"groups/details?group_id={group.group_id}")">Details</a> |
    </TemplateColumn>
</QuickGrid>
<Paginator State="pagination" />

@code {
    [SupplyParameterFromQuery]
    string? TitleFilter { get; set; }

    IQueryable<Group> FilteredGroups => context.Groups.Where(g => g.group_name.Contains(TitleFilter ?? string.Empty));

    PaginationState pagination = new PaginationState { ItemsPerPage = 3 };

    private AcademyContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
