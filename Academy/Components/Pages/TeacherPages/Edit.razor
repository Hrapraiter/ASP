@page "/teachers/edit"
@rendermode InteractiveServer
@using Academy.Components.Controls
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

@if (Teacher is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>@Teacher.FullName edit</h1>
    <hr />
     <div>
         <EditForm method="post" Model="Teacher" OnValidSubmit="UpdateTeacher" FormName="edit" Enhance>
             <DataAnnotationsValidator />
             <ValidationSummary role="alert" />
             <div class="human-container">
                 <div class="human-text-fields">
                     <input type="hidden" name="Teacher.teacher_id" value="@Teacher.teacher_id" />

                     <div class="mb-3">
                         <span class="text-danger">*</span>
                         <label for="last_name" class="form-label">last_name:</label>
                         <InputText id="last_name" @bind-Value="Teacher.last_name" class="form-control" aria-required="true" />
                         <ValidationMessage For="() => Teacher.last_name" class="text-danger" />
                     </div>
                     <div class="mb-3">
                         <span class="text-danger">*</span>
                         <label for="first_name" class="form-label">first_name:</label>
                         <InputText id="first_name" @bind-Value="Teacher.first_name" class="form-control" aria-required="true" />
                         <ValidationMessage For="() => Teacher.first_name" class="text-danger" />
                     </div>
                     <div class="mb-3">
                         <label for="middle_name" class="form-label">middle_name:</label>
                         <InputText id="middle_name" @bind-Value="Teacher.middle_name" class="form-control" />
                         <ValidationMessage For="() => Teacher.middle_name" class="text-danger" />
                     </div>
                     <div class="mb-3">
                         <span class="text-danger">*</span>
                         <label for="birth_date" class="form-label">birth_date:</label>
                         <InputDate id="birth_date" @bind-Value="Teacher.birth_date" class="form-control" aria-required="true" />
                         <ValidationMessage For="() => Teacher.birth_date" class="text-danger" />
                     </div>
                     <div class="mb-3">
                         <label for="email" class="form-label">email:</label>
                         <InputText id="email" @bind-Value="Teacher.email" class="form-control" />
                         <ValidationMessage For="() => Teacher.email" class="text-danger" />
                     </div>
                     <div class="mb-3">
                         <label for="phone" class="form-label">phone:</label>
                         <InputText id="phone" @bind-Value="Teacher.phone" class="form-control" />
                         <ValidationMessage For="() => Teacher.phone" class="text-danger" />
                     </div>
                     @* <div class="mb-3">
                     <label for="photo" class="form-label">photo:</label>
                     <InputText id="photo" @bind-Value="Teacher.photo" class="form-control" />
                     <ValidationMessage For="() => Teacher.photo" class="text-danger" />
                     </div>
                     <div class="mb-3">
                     <label for="fullname" class="form-label">FullName:</label>
                     <InputText id="fullname" @bind-Value="Teacher.FullName" class="form-control" />
                     <ValidationMessage For="() => Teacher.FullName" class="text-danger" />
                     </div>
                     <div class="mb-3">
                     <label for="age" class="form-label">Age:</label>
                     <InputNumber id="age" @bind-Value="Teacher.Age" class="form-control" />
                     <ValidationMessage For="() => Teacher.Age" class="text-danger" />
                     </div> *@
                     <div class="mb-3">
                         <label for="work_since" class="form-label">work_since:</label>
                         <InputDate id="work_since" @bind-Value="Teacher.work_since" class="form-control" />
                         <ValidationMessage For="() => Teacher.work_since" class="text-danger" />
                     </div>
                     <div class="mb-3">
                         <label for="rate" class="form-label">rate:</label>
                         <InputNumber id="rate" @bind-Value="Teacher.rate" class="form-control" />
                         <ValidationMessage For="() => Teacher.rate" class="text-danger" />
                     </div>
                 </div>
                 <Photo Human="Teacher" AllowChange="true"/>
             </div>

            @using (AcademyContext context = DbFactory.CreateDbContext())
            {
                <label class="form-label">Дисциплины:</label>
                <ul>
                    @foreach (Discipline discipline in context.Disciplines)
                    {
                        <li style="display:flex">
                            <input type="checkbox" @bind="isDisciplines[discipline.discipline_id]" />
                            <label>@discipline.discipline_name</label>
                        </li>  
                    }
                </ul>
            }
            <button type="submit" class="btn btn-primary">Save</button>
         </EditForm>
     </div>
        
}

<div>
    <a href="/teachers" class="btn btn-dark">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int teacher_id { get; set; }

    [SupplyParameterFromForm]
    private Teacher? Teacher { get; set; }

    public Dictionary<int, bool> isDisciplines { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        IQueryable<Discipline> disciplines = context.Disciplines.Include(d => d.TDR);
        Teacher ??= await context.Teachers.Include(t => t.TDR).ThenInclude(tdr => tdr.Discipline).FirstOrDefaultAsync(m => m.teacher_id == teacher_id);
        HashSet<int> selectedDisciplines = Teacher!.TDR.Select(tdr => tdr.discipline).ToHashSet();
        isDisciplines = disciplines.ToDictionary(d => d.discipline_id, d => selectedDisciplines.Contains(d.discipline_id));

        if (Teacher is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateTeacher()
    {
        using var context = DbFactory.CreateDbContext();

        IQueryable<Discipline> disciplines = context.Disciplines;
        HashSet<int> currentIds = Teacher.TDR.Select(tdr => tdr.discipline).ToHashSet();
        HashSet<int> selectedIds = isDisciplines.Where(kvp => kvp.Value).Select(kvp => kvp.Key).ToHashSet();

        context.TeachersDisciplinesRelation.RemoveRange
        (
            Teacher.TDR.Where(tdr => !selectedIds.Contains(tdr.discipline))
                       .ToArray()
        );
        context.TeachersDisciplinesRelation.AddRange
        (
            selectedIds.Where(id => !currentIds.Contains(id))
                       .Select(id => new TeachersDisciplinesRelation
                       {
                            teacher = Teacher.teacher_id,
                            discipline = id
                       })
                       .ToArray()
        );

        context.Attach(Teacher!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!TeacherExists(Teacher!.teacher_id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo($"/teachers/details?teacher_id={Teacher.teacher_id}");
    }

    private bool TeacherExists(int teacher_id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Teachers.Any(e => e.teacher_id == teacher_id);
    }
}
