@using Academy.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AcademyContext> DbFactory

@* <h3>AddDiscipline</h3>*@
<form @onsubmit="Update">
    <h5>Выберите дисциплину</h5>
    <InputSelect @bind-Value="discipline" class="form-control">
        <option selected disabled value="-1">--- Выберите дисциплину ---</option>
        @if(Disciplines != null)
        {
            @foreach(Discipline d in Disciplines)
            {
                if 
                (
                    TDR.Any(tdr => tdr.discipline == d.discipline_id) ||
                    NewDisciplines.Any(nd => nd.discipline == d.discipline_id)
                ) continue;
                <option value="@d.discipline_id">@d.discipline_name</option>
            }
        }
    </InputSelect>
    <button type="button" class="btn btn-primary" @onclick="AddDiscipline">Добавить</button>
    
    
    <ul>
        @foreach(TeachersDisciplinesRelation tdr in NewDisciplines)
        {
            <li>@tdr.Discipline.discipline_name</li>
        }
    </ul>
    <hr />
    <ul>
        @if(TDR != null)
        {
            @foreach(TeachersDisciplinesRelation tdr in TDR)
            {
                <li>@tdr.Discipline.discipline_name</li>
            }
        }
    </ul>
</form>

@code 
{
    [Parameter]
    public Teacher Teacher { get; set; } = null!;
    ICollection<Discipline> Disciplines { get; set; }
    ICollection<TeachersDisciplinesRelation> TDR { get; set; }
    List<TeachersDisciplinesRelation> NewDisciplines = new();

    int discipline = -1;

    protected override async Task OnInitializedAsync()
    {
        using AcademyContext context = DbFactory.CreateDbContext();
        Disciplines = await context.Disciplines.ToListAsync();
        TDR = await context.TeachersDisciplinesRelation.Where(t => t.teacher == Teacher.teacher_id).ToListAsync();
    }
    public async Task Update()
    {
        using AcademyContext context = DbFactory.CreateDbContext();
        List<TeachersDisciplinesRelation> pairs = new List<TeachersDisciplinesRelation>();
        foreach(TeachersDisciplinesRelation tdr in NewDisciplines)
            pairs.Add(new TeachersDisciplinesRelation { teacher = Teacher.teacher_id, discipline = tdr.discipline });
        
        await context.TeachersDisciplinesRelation.AddRangeAsync(pairs);
        await context.SaveChangesAsync();
    }
    void AddDiscipline()
    {
        if (discipline == -1) return;
        {
            if (NewDisciplines.Any(d => d.discipline == discipline)) return;
            TeachersDisciplinesRelation newRelation =
                new TeachersDisciplinesRelation
                    {
                        teacher = Teacher.teacher_id,
                        discipline = this.discipline
                    };
            newRelation.Teacher = Teacher;
            newRelation.Discipline = Disciplines.FirstOrDefault(d => d.discipline_id == discipline);
            
            NewDisciplines.Add(newRelation);
            discipline = -1;
        }
    }
}
