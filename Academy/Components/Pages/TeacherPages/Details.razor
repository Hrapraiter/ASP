@page "/teachers/details"
@using Academy.Components.Controls
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@* <h1>Details</h1> *@

<div>
    @* <h2>Teacher</h2>
    <hr /> *@
    @if (teacher is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div class="controls">
            <h1>@teacher.FullName</h1>
            <a href="@($"/teachers/edit?teacher_id={teacher.teacher_id}")" class="btn btn-primary">Edit</a>
        </div>
        <hr />
        <div class="human-container">
                <dl class="human-text-fields">
                    <dt class="col-sm-4">FullName</dt>    <dd class="col-sm-10">@teacher.FullName</dd>
                    <dt class="col-sm-4">Age</dt>         <dd class="col-sm-10">@teacher.Age</dd>
                    @*<dt class="col-sm-4">last_name</dt>   <dd class="col-sm-10">@teacher.last_name</dd>
                    <dt class="col-sm-4">first_name</dt>  <dd class="col-sm-10">@teacher.first_name</dd>
                    <dt class="col-sm-4">middle_name</dt> <dd class="col-sm-10">@teacher.middle_name</dd> *@
                    <dt class="col-sm-4">birth_date</dt>  <dd class="col-sm-10">@teacher.birth_date</dd>
                    <dt class="col-sm-4">email</dt>       <dd class="col-sm-10">@teacher.email</dd>
                    <dt class="col-sm-4">phone</dt>       <dd class="col-sm-10">@teacher.phone</dd>
                    @* <dt class="col-sm-4">photo</dt>       <dd class="col-sm-10">@teacher.photo</dd> *@
                    <dt class="col-sm-ё4">work_since</dt>  <dd class="col-sm-10">@teacher.work_since</dd>
                    <dt class="col-sm-4">rate</dt>        <dd class="col-sm-10">@teacher.rate</dd>
                </dl>
            <Photo Human="teacher" />
        </div>
        <div>
            <a href="@($"/teachers/delete?teacher_id={teacher.teacher_id}")" class="btn btn-danger">Delete</a>
            <a href="@($"/teachers")" class="btn btn-dark">Back to List</a>
        </div>
        <div class="controls">
            <h3>Дисциплины:</h3>
            <h5>discipline_count: @teacher.TDR.Count()</h5>
        </div>
        <ul>
            @foreach(TeachersDisciplinesRelation tdr in teacher.TDR)
            {
                <li>@tdr.Discipline.discipline_name</li>
            }
        </ul>
    }
</div>

@code {
    private Teacher? teacher;

    [SupplyParameterFromQuery]
    private int teacher_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        teacher = await context.Teachers.Include(t => t.TDR)
                                        .ThenInclude(tdr => tdr.Discipline)
                                        .FirstOrDefaultAsync(m => m.teacher_id == teacher_id);

        if (teacher is null)
        {
            NavigationManager.NotFound();
        }
    }
}
