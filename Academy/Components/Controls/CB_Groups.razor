@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory

<h5>Group:</h5>
<InputSelect @bind-Value="Student.group" class="form-control">
    @* <option selected disabled>---Выберите группу---</option> *@
    @using (AcademyContext context = DbFactory.CreateDbContext())
    {
        Group? first_group = context.Groups.FirstOrDefault();
        if(first_group != null)
        {
            if (Student.group == null)
            {
                <option selected value="@first_group.group_id">@first_group.group_name</option>
                @foreach (Group group in context.Groups.Where(g => g.group_id != first_group.group_id))
                {
                    <option value="@group.group_id">@group.group_name</option>
                }
            }
            else
            {
                @foreach (Group group in context.Groups)
                {
                    <option value="@group.group_id">@group.group_name</option>
                }
            }
        }
    }
</InputSelect>
<ValidationMessage For="() => Student.group" class="text-danger" />
@code 
{
    [Parameter]
    public Student Student { get; set; }

}
